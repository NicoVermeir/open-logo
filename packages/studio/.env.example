# OpenAI-compatible vision endpoint. Authentication uses the local Azure CLI Entra context.
# Azure OpenAI example: https://RESOURCE.openai.azure.com/openai/deployments/DEPLOYMENT/chat/completions?api-version=2025-01-01-preview
# OpenAI-compatible example: https://api.openai.com/v1/chat/completions
OPENLOGO_LLM_ENDPOINT=
OPENLOGO_LLM_MODEL=gpt-4.1

# OAuth resource scope. The proxy requests a token for this resource via `az account get-access-token`.
OPENLOGO_LLM_SCOPE=https://ai.azure.com/.default

# Optional tenant override. Otherwise the current `az login` tenant is used.
OPENLOGO_AZURE_TENANT_ID=
