# OpenAI-compatible vision endpoint. Authentication uses the local Azure CLI Entra context.
# Azure OpenAI example: https://RESOURCE.openai.azure.com/openai/deployments/DEPLOYMENT/chat/completions?api-version=2025-01-01-preview
# OpenAI-compatible example: https://api.openai.com/v1/chat/completions
OPENLOGO_LLM_ENDPOINT=
OPENLOGO_LLM_MODEL=gpt-4.1

# Optional, for deployments supporting reasoning_effort. Blank preserves the model default.
# For gpt-5-mini, compare low against the default medium using the same board image.
# Leave blank for non-reasoning models such as gpt-4.1.
OPENLOGO_LLM_REASONING_EFFORT=

# Board-recognition request timeout in milliseconds. Defaults to 20000.
OPENLOGO_LLM_TIMEOUT_MS=20000

# OAuth resource scope. The proxy requests a token for this resource via `az account get-access-token`.
OPENLOGO_LLM_SCOPE=https://ai.azure.com/.default

# Optional tenant override. Otherwise the current `az login` tenant is used.
OPENLOGO_AZURE_TENANT_ID=

# Realtime voice tutor. Vite exchanges the local Azure CLI Entra identity for a browser-safe,
# short-lived client secret; no standard Azure/OpenAI key is exposed to the browser.
OPENLOGO_REALTIME_RESOURCE=
OPENLOGO_REALTIME_DEPLOYMENT=gpt-realtime
OPENLOGO_REALTIME_TRANSCRIPTION_DEPLOYMENT=gpt-4o-transcribe
OPENLOGO_REALTIME_VOICE=coral
